# ===== کلاس برای مدیریت قالب‌های پیش‌فرض (در صورت نیاز آینده) =====

class DefaultTemplateRegistry:
    """
    ثبت‌نام قالب‌های پیش‌فرض - در صورت نیاز آینده
    
    این کلاس برای امکان اضافه کردن قالب‌های پیش‌فرض در آینده طراحی شده است.
    اما فعلاً هیچ قالبی ندارد.
    """
    
    _templates = {}
    _categories = set()
    _by_category = {}
    _summaries = {}
    
    @classmethod
    def register_template(cls, name: str, template_data: dict):
        """
        ثبت یک قالب جدید (برای استفاده در آینده)
        
        Args:
            name: نام قالب
            template_data: داده‌های قالب
        """
        cls._templates[name] = template_data
        category = template_data.get('category', 'Other')
        cls._categories.add(category)
        
        if category not in cls._by_category:
            cls._by_category[category] = []
        cls._by_category[category].append(name)
        
        cls._summaries[name] = template_data.get('summary', {})
    
    @classmethod
    def get_all_templates(cls) -> dict:
        """دریافت همه قالب‌های ثبت شده"""
        return cls._templates.copy()
    
    @classmethod
    def get_template(cls, name: str) -> dict:
        """دریافت یک قالب خاص"""
        return cls._templates.get(name)
    
    @classmethod
    def get_categories(cls) -> list:
        """دریافت لیست دسته‌بندی‌ها"""
        return sorted(cls._categories)
    
    @classmethod
    def get_templates_by_category(cls, category: str) -> list:
        """دریافت قالب‌های یک دسته"""
        return cls._by_category.get(category, [])
    
    @classmethod
    def get_summary(cls, name: str) -> dict:
        """دریافت خلاصه I/O یک قالب"""
        return cls._summaries.get(name, {})
    
    @classmethod
    def clear(cls):
        """پاک کردن همه قالب‌ها"""
        cls._templates.clear()
        cls._categories.clear()
        cls._by_category.clear()
        cls._summaries.clear()


